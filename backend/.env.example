# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=ats
DATABASE_USER=root
DATABASE_PASSWORD=

# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# bcrypt cost factor (10-12 is typical)
BCRYPT_ROUNDS=10
